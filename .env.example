# Credenciales de Mercado Pago.
# Copiar estos nombres en Vercel: Settings -> Environment Variables.
# El Access Token NUNCA debe subirse al repositorio ni llegar al navegador.

MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxxxx-xxxxxxxxxxxx-xxxxxxxxx
NEXT_PUBLIC_SITIO_URL=https://trayectoliceo.com

# Dónde caen los prospectos de los formularios previos al pago.
# Puede ser una URL de Google Apps Script, Make, Zapier o tu propio CRM.
# Si se deja vacía, los prospectos quedan en los logs de Vercel.
LEADS_WEBHOOK_URL=
